{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@maxmilton/oxlint-config/recommended.json",
    "./node_modules/@maxmilton/oxlint-config/stage1.json",
  ],
  "options": {
    "maxWarnings": 20,
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": false,
    "typeAware": true,
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    // "pedantic": "warn", // TODO: Enable when we can fix all the issues.
    "perf": "error",
    "style": "warn",
    "restriction": "error",
    "nursery": "warn",
  },
  // https://github.com/oxc-project/javascript-globals/blob/main/src/generated/mod.rs#L213
  "env": {
    "builtin": true,
    "es2026": true, // TODO: es2027 once in oxc.
    "bun": true,
    "commonjs": false,
    "browser": true,
    "webextensions": true,
  },
  "rules": {
    "typescript/promise-function-async": "off",
    "typescript/strict-boolean-expressions": "off", // too pedantic

    // TODO: These are buggy. Remove after future oxlint updates.
    "typescript/prefer-readonly-parameter-types": "off",
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "eslint/no-plusplus": "off", // byte savings
        "eslint/prefer-named-capture-group": "off", // byte savings
        "unicorn/prefer-at": "off", // bad browser support
      },
    },
    {
      "files": ["test/**/*.test.ts", "test/**/*.spec.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "unicorn/consistent-function-scoping": "off", // tests may define scoped helpers
      },
    },
    {
      "files": ["test/unit/**", "test/setup.ts"],
      "env": {
        "node": true,
      },
      "globals": {
        "$console": "readonly",
        "happyDOM": "readonly",
      },
    },
    {
      "files": ["test/e2e/**"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/consistent-test-filename": ["error", { "pattern": ".*\\.spec\\.ts$" }],
      },
    },
  ],
}
