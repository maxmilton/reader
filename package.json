{
  "name": "reader",
  "version": "0.3.0",
  "private": true,
  "description": "📖 Web page speed reader.",
  "homepage": "https://github.com/maxmilton/reader",
  "bugs": "https://github.com/maxmilton/reader/issues",
  "license": "MIT",
  "author": "Max Milton <max@2okki.com>",
  "repository": "github:maxmilton/reader",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "NODE_ENV=production bun build.ts",
    "dev": "NODE_ENV=development bun build.ts",
    "lint": "bun lint:fmt && bun lint:css && bun lint:js && bun lint:ts",
    "lint:css": "stylelint '**/*.{css,xcss}'",
    "lint:fmt": "oxfmt --check",
    "lint:js": "oxlint --format=stylish",
    "lint:ts": "tsc --noEmit",
    "test": "bun test --only-failures",
    "test:ci": "bun test --coverage --randomize --rerun-each=3",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ekscss/framework": "0.0.61-next.0",
    "@maxmilton/html-parser": "0.0.15",
    "bugbox": "0.0.4",
    "stage1": "0.10.0"
  },
  "devDependencies": {
    "@maxmilton/oxlint-config": "0.0.19",
    "@maxmilton/stylelint-config": "0.4.4",
    "@maxmilton/test-utils": "0.0.18",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/chrome": "0.2.9",
    "@types/csso": "5.0.5",
    "bun-plugin-ekscss": "0.0.4-next.0",
    "csso": "5.0.5",
    "ekscss": "0.0.24-next.0",
    "happy-dom": "20.14.0",
    "lightningcss": "1.33.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "purgecss": "8.0.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "terser": "5.51.2",
    "typescript": "7.0.2"
  }
}
